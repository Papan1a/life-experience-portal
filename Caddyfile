# Caddyfile
# Reverse proxy with automatic TLS.
# Place your domain below; Caddy obtains Let's Encrypt certs automatically.

{
    email {$CADDY_EMAIL:admin@lep.example.com}
}

{$DOMAIN:localhost} {
    # Spring Boot app
    reverse_proxy app:8080

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Adminer — restrict by IP allowlist (VPS internal or VPN).
{$DOMAIN:localhost}/adminer* {
    @allowed remote_ip {$ADMINER_ALLOWED_IPS:127.0.0.1}
    handle @allowed {
        reverse_proxy adminer:8080
    }
    handle {
        respond "403 Forbidden" 403
    }
}
